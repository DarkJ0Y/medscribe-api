# Copy to .env and edit. Every value below is already the default in
# config/settings.py, so an absent .env yields a working mock deployment.

# ---------------------------------------------------------------- adapters
# The master switch. true  -> MockTranscriptionAdapter + MockOCRAdapter
#                            (no API keys, no network, no model downloads)
#                   false -> RealTranscriptionAdapter + RealOCRAdapter,
#                            which require the `real` extra to be installed.
USE_MOCK_ADAPTERS=true

# --------------------------------------------------------------- app/http
APP_NAME=medscribe
LOG_LEVEL=INFO
# Trailing slash-free base path for the versioned API. A trailing slash is
# stripped and a missing leading slash is rejected at startup.
API_V1_PREFIX=/api/v1
# Inbound header carrying a correlation id; echoed back and attached to logs.
REQUEST_ID_HEADER=X-Request-ID

# ------------------------------------------------------- upload limits
# Enforced in the API layer before the body is buffered. 25 MiB per the spec.
MAX_AUDIO_BYTES=26214400
MAX_IMAGE_BYTES=26214400

# Media-type allowlists. Rarely changed; overridable as a JSON array, e.g.
#   ALLOWED_IMAGE_EXTENSIONS='[".jpg", ".png"]'
# Extensions are lower-cased and dot-prefixed for you. Defaults live in
# config/settings.py -- audio accepts wav/mp3/m4a/mp4/ogg/oga/flac/webm, images
# accept jpg/jpeg/png.
# ALLOWED_AUDIO_EXTENSIONS=
# ALLOWED_AUDIO_CONTENT_TYPES=
# ALLOWED_IMAGE_EXTENSIONS=
# ALLOWED_IMAGE_CONTENT_TYPES=

# ------------------------------------------------- transcription (real)
# Only read when USE_MOCK_ADAPTERS=false.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
# Seconds; a provider call exceeding this surfaces as HTTP 504.
TRANSCRIPTION_TIMEOUT_SECONDS=120

# Mean-amplitude floor below which audio is treated as containing no speech and
# answered with an explicit no-speech result (HTTP 200, empty transcript).
SILENCE_RMS_THRESHOLD=0.005
# Whisper's own no-speech score. Above this a segment is discarded even when the
# model emitted text for it -- it hallucinates confident sentences over ambient
# noise, and an invented transcript is worse than an empty one.
NO_SPEECH_PROBABILITY_THRESHOLD=0.6

# ----------------------------------------------------------- ocr (real)
# Path to the tesseract binary; blank means "find it on PATH".
TESSERACT_CMD=
# Tesseract language packs, '+'-joined. ben = Bengali, eng = English.
TESSERACT_LANGS=eng+ben
# Seconds; an OCR run exceeding this surfaces as HTTP 504.
OCR_TIMEOUT_SECONDS=60

# A page yielding fewer than this many recognizable test rows is reported as
# "not a lab report" rather than returned as garbage.
MIN_LAB_ROWS_FOR_REPORT=2

# --------------------------------------------------------------- testdata
# Root for the mock adapters' canned responses.
TESTDATA_DIR=testdata
